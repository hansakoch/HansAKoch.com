---
import Base from '../layouts/Base.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hans Al Koch",
  "givenName": "Hans",
  "familyName": "Koch",
  "email": "hans@hansakoch.com",
  "telephone": "+447441900339",
  "url": "https://hansakoch.com",
  "sameAs": [
    "https://github.com/hansakoch",
    "https://x.com/hansakoch",
    "https://linkedin.com/in/hansakochcom",
    "https://www.facebook.com/hanskoch/"
  ],
  "jobTitle": "Ai Systems Architect",
  "worksFor": {
    "@type": "Organization",
    "name": "OpenRoyleAl",
    "url": "https://openroyleal.com"
  }
};
---
<Base
  title="Hans Al Koch (HAK) — Ai Architect & Autonomous Systems Builder"
  description="Hans Al Koch (HAK) — Ai Architect, OpenClaw ecosystem builder. Building sovereign Ai infrastructure. Based in Cebu, Philippines."
  schema={schema}
>
  <header style="text-align:center;margin-bottom:48px;">
    <h1 style="font-size:2.4rem;font-weight:700;color:var(--accent);letter-spacing:-0.02em;margin-bottom:8px;">Hans Al Koch <span style="color:var(--muted);font-size:1.2rem;">(HAK)</span></h1>
    <p style="font-size:1.1rem;color:var(--muted);">Ai Architect & Autonomous Systems Builder</p>
  </header>

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:32px;margin-bottom:32px;">
    <p style="margin-bottom:16px;">OpenClaw early adopter and ecosystem builder — started January 2025 at 18.7K stars, now 361K+. Organizer of the <strong>OpenClaw Cebu 🦞</strong> community. 14+ years in digital marketing, now building sovereign Ai infrastructure.</p>
    <p style="margin-bottom:16px;">I build Ai agents that work 24/7/365 across distributed nodes — automating workflows, managing cloud infrastructure, and executing business operations autonomously.</p>
    <p>Leading the pivot of Iceberg Media from traditional SEO to Ai agent implementation, delivering £20K–£35K enterprise projects.</p>
  </div>

  <h3 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:16px;margin-top:32px;">🌐 Socials</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:32px;">
    <a href="https://github.com/hansakoch" target="_blank" rel="me" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      GitHub
    </a>
    <a href="https://x.com/hansakoch" target="_blank" rel="me" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      X / Twitter
    </a>
    <a href="https://linkedin.com/in/hansakochcom" target="_blank" rel="me" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      LinkedIn
    </a>
    <a href="https://www.facebook.com/hanskoch/" target="_blank" rel="me" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      Facebook
    </a>
  </div>

  <h3 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:16px;margin-top:32px;">🚀 Projects</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:32px;">
    <a href="https://openroyleal.com" target="_blank" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <span style="font-size:1.2rem;">🧠</span> OpenRoyleAl
    </a>
    <a href="https://messagewith.me" target="_blank" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <span style="font-size:1.2rem;">💬</span> Messagewith.me
    </a>
    <a href="https://reservewith.me" target="_blank" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <span style="font-size:1.2rem;">📅</span> Reservewith.me
    </a>
    <a href="https://dininghaul.app" target="_blank" style="background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.95rem;transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <span style="font-size:1.2rem;">🍽️</span> DiningHaul.app
    </a>
  </div>

  <h3 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:16px;margin-top:32px;">📄 Documents</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:32px;">
    <a href="/cv" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-decoration:none;color:var(--text);transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <div style="font-weight:600;margin-bottom:4px;">Curriculum Vitae <span style="display:inline-block;font-size:0.7rem;background:var(--accent);color:#fff;padding:2px 8px;border-radius:10px;font-weight:600;margin-left:6px;">CV</span></div>
      <div style="font-size:0.85rem;color:var(--muted);">Full professional history</div>
    </a>
    <a href="/resume" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-decoration:none;color:var(--text);transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <div style="font-weight:600;margin-bottom:4px;">Resume <span style="display:inline-block;font-size:0.7rem;background:var(--accent);color:#fff;padding:2px 8px;border-radius:10px;font-weight:600;margin-left:6px;">PDF</span></div>
      <div style="font-size:0.85rem;color:var(--muted);">Professional resume — print-friendly</div>
    </a>
    <a href="/cover-letter" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;text-decoration:none;color:var(--text);transition:all 0.2s;" onmouseover="this.style.borderColor='var(--accent-dim)'" onmouseout="this.style.borderColor='var(--border)'">
      <div style="font-weight:600;margin-bottom:4px;">Cover Letter <span style="display:inline-block;font-size:0.7rem;background:var(--accent);color:#fff;padding:2px 8px;border-radius:10px;font-weight:600;margin-left:6px;">PDF</span></div>
      <div style="font-size:0.85rem;color:var(--muted);">General cover letter</div>
    </a>
  </div>

  <footer style="text-align:center;color:var(--muted);font-size:0.8rem;margin-top:48px;padding-top:24px;border-top:1px solid var(--border);">
    <p><a href="/contact">Contact</a></p>
  </footer>
