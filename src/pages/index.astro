    </a>
  </div>

  <!-- Documents -->
  <h3 style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:12px;">📄 Documents</h3>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px;margin-bottom:28px;">
    <a href="/cv" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;text-decoration:none;color:var(--text);transition:all 0.2s;box-shadow:0 2px 8px rgba(0,0,0,0.2);" onmouseover="this.style.borderColor='var(--accent-dim)';this.style.boxShadow='0 4px 20px rgba(255,51,51,0.15)'" onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='0 2px 8px rgba(0,0,0,0.2)'">
      <div style="font-weight:600;margin-bottom:4px;">Curriculum Vitae</div>
      <div style="font-size:0.85rem;color:var(--muted);">Full professional history</div>
    </a>
    <a href="/resume" style="display:block;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;text-decoration:none;color:var(--text);transition:all 0.2s;box-shadow:0 2px 8px rgba(0,0,0,0.2);" onmouseover="this.style.borderColor='var(--accent-dim)';this.style.boxShadow='0 4px 20px rgba(255,51,51,0.15)'" onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='0 2px 8px rgba(0,0,0,0.2)'">
      <div style="font-weight:600;margin-bottom:4px;">Resume</div>
      <div style="font-size:0.85rem;color:var(--muted);">Download or print — mobile-friendly</div>
    </a>
  </div>

