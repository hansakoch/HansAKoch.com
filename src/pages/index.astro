    <a href="https://rosari.org" target="_blank" style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px 18px;text-decoration:none;color:var(--text);display:flex;align-items:center;gap:10px;font-weight:500;font-size:0.93rem;transition:all 0.2s;box-shadow:0 2px 8px rgba(0,0,0,0.2);" onmouseover="this.style.borderColor='var(--accent-dim)';this.style.boxShadow='0 4px 20px rgba(255,51,51,0.15)'" onmouseout="this.style.borderColor='var(--border)';this.style.boxShadow='0 2px 8px rgba(0,0,0,0.2)'">
