---
import Base from '../layouts/Base.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hans Al Koch",
  "givenName": "Hans",
  "additionalName": "Al",
  "familyName": "Koch",
  "alternateName": ["HAK", "Hans Al Koch"],
  "email": "hans@hansakoch.com",
  "telephone": "+447882517454",
  "url": "https://hansakoch.com",
  "sameAs": [
    "https://github.com/hansakoch",
    "https://x.com/hansakoch",
    "https://linkedin.com/in/hansakochcom",
    "https://www.facebook.com/hanskoch/",
    "https://alfred.report"
  ],
  "jobTitle": "Director of Agent Optimization",
  "worksFor": [
    { "@type": "Organization", "name": "OpenRoyleAl", "url": "https://openroyleal.com" },
    { "@type": "Organization", "name": "Iceberg Media", "url": "https://icebergmedia.co.uk" }
  ]
};
---
<Base
  title="Hans Al Koch (HAK) — Director of Agent Optimization"
  description="Hans Al Koch (HAK) — Director of Agent Optimization. CF Alfred (CFA). Alfred, report!"
  schema={schema}
>
  <header style="text-align:center;margin-bottom:20px;padding-top:0;">
    <h1 style="font-size:2.2rem;font-weight:700;color:var(--accent);letter-spacing:-0.02em;margin-bottom:0;line-height:1.15;">Hans Al Koch</h1>
    <p style="color:var(--muted);font-size:0.9rem;margin-bottom:2px;line-height:1.2;display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;">
      <span>(HAK) @HansAKoch</span>
      <span style="display:flex;gap:12px;align-items:center;">
        <a href="https://github.com/hansakoch" target="_blank" rel="me" title="GitHub" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg></a>
        <a href="https://x.com/hansakoch" target="_blank" rel="me" title="X / Twitter" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="https://linkedin.com/in/hansakochcom" target="_blank" rel="me" title="LinkedIn" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
        <a href="https://www.facebook.com/hanskoch/" target="_blank" rel="me" title="Facebook" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
      </span>
    </p>
    <p style="font-size:0.95rem;color:var(--muted);margin-bottom:0;margin-top:4px;">Director of Agent Optimization</p>
    <p style="font-size:0.8rem;color:var(--muted);margin-top:2px;">CF Alfred (CFA). <a href="https://alfred.report" style="color:var(--accent-dim);">Alfred, report!</a></p>
  </header>

  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:24px;box-shadow:0 4px 24px rgba(0,0,0,0.3);">
    <p style="margin-bottom:12px;">Digital marketing since 1999 — first webmaster in high school. Now I build agents that don't sleep.</p>
    <p style="margin-bottom:12px;">Early on <a href="https://github.com/openclaw/openclaw" style="color:var(--accent-dim);font-weight:600;">OpenClaw</a> (Jan 2025 at 18.7K ⭐, now <strong><span id="openclaw-stars">388K</span> ⭐</strong>). Running <a href="https://icebergmedia.co.uk" style="color:var(--accent-dim);">Iceberg Media</a> 14 years — UK SEO, most clients in Britain — pivoting the shop to Cloudflare-first agents across 145+ domains.</p>
  </div>

  <!-- Projects with Alpha/Beta/Delta badges -->
  <h3 style="font-size:0.8rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:12px;margin-top:24px;">🚀 Projects</h3>
  <div class="projects-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:32px;">
    <div class="cf-memory-card" style="grid-column:1/-1;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px 18px;color:var(--text);box-shadow:0 2px 8px rgba(0,0,0,0.2);">
