---
import Base from '../layouts/Base.astro';
---
<Base
  title="Contact — Hans A. Koch (HAK)"
  description="Get in touch with Hans A. Koch (HAK) — Director of Agent Optimization."
  ogUrl="https://hansakoch.com/contact"
>
  <a href="https://hansakoch.com/" style="display:inline-block;margin-bottom:32px;color:var(--accent-dim);font-size:0.9rem;">← hansakoch.com</a>

  <h1 style="font-size:2rem;color:var(--accent);margin-bottom:8px;">Contact</h1>
  <p style="color:var(--muted);margin-bottom:32px;">Get in touch — I'll get back to you as soon as possible.</p>

  <!-- Contact form — Material Design card -->
  <form action="https://usebasin.com/f/3459a748d9d0" method="POST" style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:32px;margin-bottom:32px;box-shadow:0 4px 24px rgba(0,0,0,0.3);">
    <label style="display:block;font-weight:600;margin-bottom:6px;font-size:0.9rem;color:var(--text);">Name</label>
    <input type="text" name="name" placeholder="Your name" required style="width:100%;padding:14px 16px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:0.95rem;margin-bottom:20px;transition:border-color 0.2s;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">

    <label style="display:block;font-weight:600;margin-bottom:6px;font-size:0.9rem;color:var(--text);">Email</label>
    <input type="email" name="email" placeholder="your@email.com" required style="width:100%;padding:14px 16px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:0.95rem;margin-bottom:20px;transition:border-color 0.2s;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">

    <label style="display:block;font-weight:600;margin-bottom:6px;font-size:0.9rem;color:var(--text);">Subject</label>
    <input type="text" name="subject" placeholder="What's this about?" style="width:100%;padding:14px 16px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:0.95rem;margin-bottom:20px;transition:border-color 0.2s;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'">

    <label style="display:block;font-weight:600;margin-bottom:6px;font-size:0.9rem;color:var(--text);">Message</label>
    <textarea name="message" placeholder="Your message..." required style="width:100%;padding:14px 16px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:inherit;font-size:0.95rem;margin-bottom:24px;resize:vertical;min-height:140px;transition:border-color 0.2s;outline:none;" onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"></textarea>

    <button type="submit" style="background:var(--accent);color:#fff;border:none;padding:16px 40px;font-size:1rem;font-weight:600;border-radius:12px;cursor:pointer;transition:all 0.2s;box-shadow:0 4px 16px rgba(255,51,51,0.3);" onmouseover="this.style.background='var(--accent-dim)';this.style.boxShadow='0 6px 24px rgba(255,51,51,0.4)'" onmouseout="this.style.background='var(--accent)';this.style.boxShadow='0 4px 16px rgba(255,51,51,0.3)'">Send Message</button>
  </form>

  <!-- Contact methods card -->
  <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:28px;box-shadow:0 4px 24px rgba(0,0,0,0.3);">
    <h3 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--muted);margin-bottom:16px;">Other ways to reach me</h3>
    <p style="margin-bottom:8px;font-size:0.9rem;">📧 Email: <a href="mailto:hans@hansakoch.com" style="color:var(--accent-dim);">hans@hansakoch.com</a></p>
    <p style="margin-bottom:8px;font-size:0.9rem;">📱 UK: <a href="tel:+447441900339" style="color:var(--accent-dim);">+44 7441 900 339</a></p>
    <p style="margin-bottom:8px;font-size:0.9rem;">📱 US: <a href="tel:+14156831016" style="color:var(--accent-dim);">+1 415 683 1016</a></p>
    <p style="margin-bottom:16px;font-size:0.9rem;">💼 LinkedIn: <a href="https://linkedin.com/in/hansakochcom" style="color:var(--accent-dim);">linkedin.com/in/hansakochcom</a></p>

    <!-- Social icons -->
    <div style="display:flex;gap:18px;margin-top:8px;">
      <a href="https://github.com/hansakoch" target="_blank" rel="me" title="GitHub" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://x.com/hansakoch" target="_blank" rel="me" title="X / Twitter" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href="https://linkedin.com/in/hansakochcom" target="_blank" rel="me" title="LinkedIn" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://www.facebook.com/hanskoch/" target="_blank" rel="me" title="Facebook" style="color:var(--muted);transition:color 0.2s;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='var(--muted)'">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
    </div>
  </div>
</Base>
