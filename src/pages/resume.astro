---
import Base from '../layouts/Base.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hans Al Koch",
  "givenName": "Hans",
  "additionalName": "Al",
  "familyName": "Koch",
  "alternateName": ["HAK", "Hans Al Koch"],
  "email": "hans@hansakoch.com",
  "telephone": ["+447882517454", "+14156831016", "+13133558675"],
  "url": "https://hansakoch.com",
  "sameAs": [
    "https://github.com/hansakoch",
    "https://x.com/hansakoch",
    "https://linkedin.com/in/hansakochcom",
    "https://www.facebook.com/hanskoch/",
    "https://alfred.report"
  ],
  "jobTitle": "Director of Agent Optimization",
  "worksFor": [
    { "@type": "Organization", "name": "OpenRoyleAl", "url": "https://openroyleal.com" },
    { "@type": "Organization", "name": "Iceberg Media", "url": "https://icebergmedia.co.uk" }
  ]
};
---
<Base
  title="Hans Al Koch (HAK) — Resume"
  description="Professional resume of Hans Al Koch (HAK) — Director of Agent Optimization. Cloudflare: Chief Agent (CFA)."
  ogType="profile"
  ogUrl="https://resume.hansakoch.com/"
  schema={schema}
>
  <a href="https://hansakoch.com/" class="no-print" style="display:inline-block;margin-bottom:24px;color:var(--accent-dim);font-size:0.9rem;">← hansakoch.com</a>

  <!-- Centered header -->
  <div style="text-align:center;margin-bottom:32px;">
    <h1 style="font-size:2rem;font-weight:700;color:var(--accent);margin-bottom:8px;">Hans Al Koch</h1>
    <p style="color:var(--muted);font-size:0.85rem;margin-bottom:4px;">Director of Agent Optimization · Cloudflare: Chief Agent (CFA)</p>
    <p style="color:var(--muted);font-size:0.9rem;margin-bottom:4px;">
      <a href="tel:+447882517454" style="color:var(--text);">+44 7882 517 454</a> · <a href="tel:+14156831016" style="color:var(--text);">+1 415 683 1016</a> · <a href="tel:+13133558675" style="color:var(--text);">+1 (313) 355-8675</a> · <a href="mailto:hans@hansakoch.com" style="color:var(--text);">hans@hansakoch.com</a>
    </p>
    <p style="color:var(--muted);font-size:0.85rem;">
      <a href="https://linkedin.com/in/hansakochcom" style="color:var(--accent-dim);">linkedin.com/in/hansakochcom</a> ·
      <a href="https://github.com/hansakoch" style="color:var(--accent-dim);">github.com/hansakoch</a> ·
      <a href="https://x.com/hansakoch" style="color:var(--accent-dim);">x.com/hansakoch</a>
    </p>
  </div>
  <hr style="border:none;border-top:2px solid var(--accent);margin:0 auto 32px auto;max-width:200px;">

  <div class="md-card" style="text-align:center;">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:16px;">Professional Summary</h2>
    <p style="font-size:0.92rem;color:#ccc;">Director of Agent Optimization. Digital marketing since 1999. Early on <a href="https://github.com/openclaw/openclaw" style="color:var(--accent-dim);font-weight:600;">OpenClaw</a> (January 2025 at 18.7K ⭐, now <strong><span id="openclaw-stars">388K</span> ⭐</strong>). Director & CMO of <a href="https://icebergmedia.co.uk" style="color:var(--accent-dim);">Iceberg Media</a> (2012–present). I build agents that don't sleep.</p>
  </div>

  <div class="md-card">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:20px;text-align:center;">Professional Experience</h2>

    <h3 style="font-size:1rem;font-weight:600;color:var(--text);">Ai Systems Architect & Founder</h3>
    <p style="font-size:0.85rem;color:var(--muted);margin-bottom:10px;"><strong style="color:var(--text);">OpenRoyleAl</strong> · January 2025 – Present</p>
    <ul style="padding-left:20px;margin-bottom:24px;">
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Architected sovereign Ai infrastructure using Cloudflare Workers, D1, Vectorize, and Durable Objects.</li>
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Built multi-node distributed task execution with 6-second average latency.</li>
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Running 24/7 infrastructure across Surface laptop, Android Pi, and Cloudflare Workers.</li>
    </ul>

    <h3 style="font-size:1rem;font-weight:600;color:var(--text);">Agency Search Director & Ai Transition Lead</h3>
    <p style="font-size:0.85rem;color:var(--muted);margin-bottom:10px;"><strong style="color:var(--text);"><a href="https://icebergmedia.co.uk" style="color:var(--accent-dim);">Iceberg Media</a></strong> · August 2022 – Present · Manchester, UK</p>
    <ul style="padding-left:20px;margin-bottom:24px;">
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Leading strategic pivot from 14-year SEO agency to Ai services company.</li>
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Managing 168 Google Business Profiles and ~110 domains.</li>
    </ul>

    <h3 style="font-size:1rem;font-weight:600;color:var(--text);">Director of Search Marketing</h3>
    <p style="font-size:0.85rem;color:var(--muted);margin-bottom:10px;"><strong style="color:var(--text);"><a href="https://icebergmedia.co.uk" style="color:var(--accent-dim);">Iceberg Media</a></strong> · November 2012 – August 2022 · Manchester, UK</p>
    <ul style="padding-left:20px;margin-bottom:24px;">
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Directed SEO and PPC campaigns across UK and USA.</li>
      <li style="margin-bottom:4px;font-size:0.92rem;color:#ccc;">Keynote speaker at international conferences in the USA and UK.</li>
    </ul>
  </div>

  <div class="md-card">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:16px;text-align:center;">Projects</h2>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Cloudflare Agent Memory</strong> — Persistent agent memory. <a href="https://github.com/hansakoch/cf-memory-plugin" style="color:var(--accent-dim);">cf-memory-plugin</a> · <a href="https://cloudflare-memory.pages.dev" style="color:var(--accent-dim);">cloudflare-memory.pages.dev</a> · <a href="https://alfred.report" style="color:var(--accent-dim);">alfred.report</a></p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>OpenRoyleAl</strong> — Ai infrastructure (2025–Present)</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Messagewith.me</strong> — Unified messaging platform (2025–Present)</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Reservewith.me / Orderwith.me</strong> — Booking & ordering (2025–Present)</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>DiningHaul.app</strong> — Food delivery discovery (2025–Present)</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>IcebergSites</strong> — Local SEO platform (Cloudflare Workers + TypeScript)</p>
  </div>

  <div class="md-card">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:16px;text-align:center;">Community</h2>
    <p style="font-size:0.92rem;color:#ccc;text-align:center;"><strong><a href="https://alfred.report" style="color:var(--accent-dim);">alfred.report</a></strong></p>
  </div>

  <div class="md-card">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:16px;text-align:center;">Technical Skills</h2>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Ai & Agents:</strong> OpenClaw, Claude Code, OpenAI, DeepSeek, Grok (xAI), prompt engineering</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Cloud:</strong> Cloudflare Workers, D1, KV, Durable Objects, Pages, DNS, 145+ domains</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Languages:</strong> TypeScript, JavaScript, Python, Bash, HTML/CSS</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:6px;"><strong>Marketing:</strong> Google Analytics, Google Ads, Facebook Ads, Google Business Profile (168 locations)</p>
  </div>

  <div class="no-print" style="text-align:center;margin-top:32px;font-size:0.85rem;color:var(--muted);">
    <p style="margin-bottom:12px;">
      <a href="#" onclick="window.print();return false;" style="display:inline-block;background:var(--accent);color:#fff;padding:10px 24px;border-radius:8px;text-decoration:none;font-weight:600;font-size:0.85rem;box-shadow:0 2px 8px rgba(255,51,51,0.3);">🖨️ Download PDF</a>
    </p>
    <p style="font-size:0.75rem;margin-bottom:12px;">Opens print dialog — choose "Save as PDF"</p>
    <p>
      <a href="/cover-letter" style="color:var(--accent-dim);">📝 Cover Letter</a> ·
      <a href="/cv" style="color:var(--accent-dim);">📋 Full CV</a> ·
      <a href="/contact" style="color:var(--accent-dim);">📬 Contact</a>
    </p>
  </div>

  <script>
    (async () => {
      const el = document.getElementById('openclaw-stars');
      try {
        const res = await fetch('https://api.github.com/repos/openclaw/openclaw');
        if (res.ok) {
          const data = await res.json();
          if (data.stargazers_count) {
            el.textContent = (data.stargazers_count / 1000).toFixed(0) + 'K';
          }
        }
      } catch (e) {}
    })();
  </script>

  <style>
    @media print {
      body { background: white !important; color: #111 !important; }
      h1, h2, h3 { color: #111 !important; }
      hr { border-color: #111 !important; }
      a { color: #111 !important; text-decoration: none !important; }
      .container { padding: 0 !important; max-width: 100% !important; }
      .md-card { box-shadow: none !important; border: none !important; background: white !important; padding: 16px 0 !important; }
      .no-print { display: none !important; }
    }
  </style>
</Base>
