    </div>
  </div>

  <!-- Footer nav -->
  <div style="text-align:center;margin-top:32px;font-size:0.9rem;color:var(--muted);">
    <a href="/resume" style="color:var(--accent-dim);">📄 Resume</a> ·
    <a href="/cv" style="color:var(--accent-dim);">📋 Full CV</a> ·
    <a href="/cover-letter" style="color:var(--accent-dim);">📝 Cover Letter</a> ·
