    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">5th SEMCON</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2011 · AIM Conference Center, Makati, Philippines</p>
      <p style="font-size:0.92rem;color:#ccc;">"Searching For Deals: How Group Buying Harnesses Search"</p>
    </div>

    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">WordCamp Philippines</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2010 · College of Saint Benilde, Manila</p>
      <p style="font-size:0.92rem;color:#ccc;">"WPPlugins Must-Haves"</p>
    </div>

    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">Search Engine Marketing Conference</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2009 · Aquinas University, Legazpi</p>
      <p style="font-size:0.92rem;color:#ccc;">"Business Models for Social Network Sites" + "E-Commerce in a Social Network"</p>
    </div>

    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">SEMCON Philippines</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2008 · Makati, Philippines</p>
      <p style="font-size:0.92rem;color:#ccc;">"Search Arbitrage Monetizing Tier 2 PPC Search Traffic"</p>
    </div>

    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">WordCamp Philippines</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2008 · College of St. Benilde, Manila</p>
      <p style="font-size:0.92rem;color:#ccc;">"WordPress for Corporate Web Sites" + "WordPress and SEO"</p>
    </div>

    <div style="margin-bottom:20px;">
      <h3 style="font-size:1rem;font-weight:600;color:var(--text);">Social Networking & eBusiness Conference</h3>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:6px;">2008 · Hotel Intercontinental, Makati</p>
      <p style="font-size:0.92rem;color:#ccc;">"Marketing through Social Networks"</p>
    </div>

    <div style="margin-bottom:20px;">
