---
import Base from '../layouts/Base.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hans Al Koch",
  "givenName": "Hans",
  "additionalName": "Al",
  "familyName": "Koch",
  "alternateName": ["HAK", "Hans Al Koch"],
  "email": "hans@hansakoch.com",
  "telephone": ["+447882517454", "+14156831016", "+13133558675"],
  "url": "https://hansakoch.com",
  "sameAs": [
    "https://github.com/hansakoch",
    "https://x.com/hansakoch",
    "https://linkedin.com/in/hansakochcom",
    "https://www.facebook.com/hanskoch/",
    "https://alfred.report",
    "https://luma.com/user/hansakoch"
  ],
  "jobTitle": "AI Systems Architect | Director of Agent Optimization",
  "worksFor": [
    { "@type": "Organization", "name": "OpenRoyleAl", "url": "https://openroyleal.com" },
    { "@type": "Organization", "name": "Iceberg Media", "url": "https://icebergmedia.co.uk" }
  ]
};
---
<Base
  title="Speaking Engagements — Hans Al Koch (HAK)"
  description="Speaking engagements and community events by Hans Al Koch (HAK) — AI Systems Architect | Director of Agent Optimization."
  ogType="profile"
  ogUrl="https://hansakoch.com/speaking"
  schema={schema}
>
  <a href="https://hansakoch.com/" style="display:inline-block;margin-bottom:24px;color:var(--accent-dim);font-size:0.9rem;">← hansakoch.com</a>

  <div style="text-align:center;margin-bottom:32px;">
    <h1 style="font-size:2rem;font-weight:700;color:var(--accent);margin-bottom:8px;">Speaking Engagements</h1>
    <p style="color:var(--muted);font-size:0.85rem;">12+ conferences and community events across the USA, UK, and Philippines</p>
  </div>
  <hr style="border:none;border-top:2px solid var(--accent);margin:0 auto 32px auto;max-width:200px;">

  <!-- OpenClaw Cebu -->
  <div class="md-card">
    <h2 style="font-size:1.1rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent);margin-bottom:16px;text-align:center;">OpenClaw Cebu Community</h2>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:10px;"><strong style="color:var(--text);">Organizer & Host</strong> · April 2026 – Present · Cebu, Philippines</p>
    <p style="font-size:0.92rem;color:#ccc;margin-bottom:10px;">Building the local AI agent development community in Cebu. Weekly meetups covering OpenClaw, autonomous agents, and Cloudflare-first architecture. 16 events hosted, 7 attended.</p>
    <p style="font-size:0.85rem;"><a href="https://luma.com/user/hansakoch" style="color:var(--accent-dim);">View all events on Luma →</a></p>
