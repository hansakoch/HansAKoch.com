---
import Base from '../layouts/Base.astro';
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Hans Al Koch",
  "givenName": "Hans",
  "additionalName": "Al",
  "familyName": "Koch",
  "alternateName": ["HAK", "Hans Al Koch"],
  "email": "hans@hansakoch.com",
  "telephone": ["+447882517454", "+13133558675"],
  "url": "https://hansakoch.com",
  "sameAs": [
    "https://github.com/hansakoch",
    "https://x.com/hansakoch",
    "https://linkedin.com/in/hansakochcom",
    "https://www.facebook.com/hanskoch/",
    "https://alfred.report"
  ],
  "jobTitle": "Director of Agent Optimization",
  "worksFor": [
    { "@type": "Organization", "name": "OpenRoyleAl", "url": "https://openroyleal.com" },
    { "@type": "Organization", "name": "Iceberg Media", "url": "https://icebergmedia.co.uk" }
